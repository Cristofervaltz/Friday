# Friday Environment Configuration
# Copy this file to .env and fill in your actual values

# LLM Provider Configuration
# Supported providers: openai, openrouter, ollama
FRIDAY_LLM_PROVIDER=openrouter

# API Keys (not required for Ollama)
FRIDAY_LLM_API_KEY=your-api-key-here

# Model Selection
# OpenAI: gpt-4, gpt-3.5-turbo, etc.
# OpenRouter: openai/gpt-4-turbo, anthropic/claude-3-sonnet, etc.
# Ollama: llama2, mistral, etc.
FRIDAY_LLM_MODEL=openai/gpt-4-turbo

# API Base URL (optional, provider-specific defaults will be used)
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama: http://localhost:11434
# FRIDAY_LLM_BASE_URL=

# Request Timeout (seconds)
FRIDAY_LLM_TIMEOUT=30

# Logging Configuration
FRIDAY_LOG_LEVEL=INFO
FRIDAY_LOG_DIR=
FRIDAY_LOG_FILENAME=friday.log
FRIDAY_CONSOLE_LOGGING=true
FRIDAY_FILE_LOGGING=true

# Application Environment
FRIDAY_ENV=development
